# Kastara Finance — environment template
# Copy ke .env lalu isi key asli. JANGAN commit .env.

# FRED API key (gratis, register di https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Path file SQLite. Default (kalau kosong): kastara-finance.db di root project.
# Rekomendasi: taruh DI LUAR folder project (biar tidak nyampur sama kode/git),
# mis. sibling folder:
# KASTARA_DB_PATH=/home/<user>/LOCAL/kastara-finance-data/kastara-finance.db

# --- Binance (VPN / region block) ---------------------------------------
# Binance sering ke-block DNS di sebagian region (mis. ID). Pilihan:
#   a) Pakai VPN, biarkan default (api.binance.com).
#   b) Route via proxy VPN lokal: set KASTARA_PROXY di bawah.
#   c) Domain data alternatif utk market data (tanpa VPN, sering lolos):
#        BINANCE_BASE=https://data-api.binance.vision
#      (catatan: futures/funding/OI tidak tersedia di domain vision)
#   d) Matikan Binance total -> otomatis fallback CoinGecko:
#        BINANCE_ENABLED=0
# BINANCE_BASE=https://api.binance.com
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_ENABLED=1

# Proxy untuk SEMUA request (mis. VPN SOCKS lokal). Kosong = tanpa proxy.
# Contoh: socks5://127.0.0.1:1080  atau  http://127.0.0.1:8080
# (untuk socks5 butuh paket 'requests[socks]')
# KASTARA_PROXY=

# --- Web dashboard (Phase 1 FE/BE) --------------------------------------
# Host & port Flask dashboard.
# WEB_HOST=127.0.0.1
# WEB_PORT=5000

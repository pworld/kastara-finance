# Kastara Finance — environment template
# Copy ke .env lalu isi key asli. JANGAN commit .env.

# FRED API key (gratis, register di https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Path file SQLite. Default (kalau kosong): kastara-finance.db di root project.
# Rekomendasi: taruh DI LUAR folder project (biar tidak nyampur sama kode/git),
# mis. sibling folder:
# KASTARA_DB_PATH=/home/<user>/LOCAL/kastara-finance-data/kastara-finance.db

# --- Binance (VPN / region block) ---------------------------------------
# Binance sering ke-block DNS di sebagian region (mis. ID). Pilihan:
#   a) Pakai VPN, biarkan default (api.binance.com).
#   b) Route via proxy VPN lokal: set KASTARA_PROXY di bawah.
#   c) Domain data alternatif utk market data (tanpa VPN, sering lolos):
#        BINANCE_BASE=https://data-api.binance.vision
#      (catatan: futures/funding/OI tidak tersedia di domain vision)
#   d) Matikan Binance total -> otomatis fallback CoinGecko:
#        BINANCE_ENABLED=0
# BINANCE_BASE=https://api.binance.com
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_ENABLED=1

# Proxy untuk SEMUA request (mis. VPN SOCKS lokal). Kosong = tanpa proxy.
# Contoh: socks5://127.0.0.1:1080  atau  http://127.0.0.1:8080
# (untuk socks5 butuh paket 'requests[socks]')
# KASTARA_PROXY=

# --- Web dashboard (Phase 1 FE/BE) --------------------------------------
# Host & port Flask dashboard.
# WEB_HOST=127.0.0.1
# WEB_PORT=5000

# --- Auth dashboard (Fase 3 migrasi FE, docs/migrationFE.md) -------------
# WAJIB diisi -- tanpa ini, login akan selalu ditolak (bukan default lolos).
# Ini kredensial asli, bukan angka placeholder -- isi sendiri, jangan commit.
# DASHBOARD_PASSWORD=
# Opsional -- kalau kosong, di-generate random tiap start proses (sesi
# ke-invalidate tiap restart). Isi kalau mau sesi tahan lintas restart:
# FLASK_SECRET_KEY=

# --- Telegram Daily Briefing (Phase E, plan_e.txt) -----------------------
# 1. Chat ke @BotFather di Telegram, /newbot, ikuti instruksi -> dapat token.
# 2. Kirim 1 pesan (mis. "/start") ke bot barumu dari akun Telegram-mu sendiri.
# 3. Jalankan `python -m notify.telegram` -> print chat_id dari update terakhir.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- OpenRouter (Panel 4: 4 Analisa AI) ----------------------------------
# 1. Daftar di https://openrouter.ai, generate API key.
# 2. Tulis system prompt tiap persona di prompts/persona_<gema|leon|akela|rivan>.txt
#    (file TIDAK dibuat otomatis & TIDAK di-commit -- lihat prompts/README.md).
#    Selama file kosong/belum ada, tombol "Jalankan Analisa" di Panel 4 akan
#    kasih tahu di UI, bukan diam-diam gagal atau jalan dengan prompt kosong.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
#   (cek model id yang tersedia & masih aktif di https://openrouter.ai/models --
# --- Coinalyze API key ---------------------------------------
# Daftar di https://coinalyze.net, generate API key.
# COINALYZE_API_KEY=

# --- Sizing engine (Phase J+ Build Contract v1.3 §14, J-3b/J-13) ---------
# Modal per segmen mata uang, dipakai analysis/sizing.py::suggest_position_size()
# (via /api/sizing/suggest) utk hitung budget risiko per trade (capital x 2.5%).
# Nilai di bawah DEFAULT/PLACEHOLDER (Rp100 juta / $10rb) -- BUKAN modal riil
# siapa pun, cuma supaya sizing engine tidak error out-of-the-box. GANTI ke
# angka modal riil kamu begitu tahu nilai pastinya.
RISK_CAPITAL_IDR=100000000
RISK_CAPITAL_USD=10000
